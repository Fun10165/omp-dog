{
	"schemaVersion": "0.9",
	"id": "do-dog-genesis",
	"root": "root",
	"background": {
		"general": "general.md",
		"specific": "specific.md"
	},
	"nodes": {
		"root": {
			"kind": "composite",
			"title": "产出高质量 DoG 图",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"completion": {
				"op": "all",
				"items": [
					{
						"op": "ref",
						"id": "group-root"
					},
					{
						"op": "ref",
						"id": "group-layers"
					},
					{
						"op": "ref",
						"id": "group-leaves"
					},
					{
						"op": "ref",
						"id": "group-engineering"
					},
					{
						"op": "ref",
						"id": "group-complete"
					}
				]
			},
			"verifier": {
				"mode": "agentic",
				"goal": "把生成的图作为整体读一遍:各维度单独都过,作为一张图是否真的可用——层级是否一眼能懂、有没有哪个方面其实和用户目标无关(过度设计)?给结论与证据。"
			}
		},
		"group-root": {
			"kind": "composite",
			"title": "根的目标正确性",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"completion": {
				"op": "all",
				"items": [
					{
						"op": "ref",
						"id": "root-from-user"
					},
					{
						"op": "ref",
						"id": "root-non-formal"
					}
				]
			}
		},
		"root-from-user": {
			"kind": "leaf",
			"title": "根与用户原始目标对齐",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "根节点与用户的原始prompt对齐:忠实反映了用户想要什么(而不是'更容易验收'的另一件事)。没有多，没有少，既没有幻觉出用户没有意图的意思，也没有遗漏用户的意图。"
			}
		},
		"root-non-formal": {
			"kind": "leaf",
			"title": "根不可形式化",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "根目标不可能被任何公式/规则/代码测试(如'字数大于X')直接判定。"
			}
		},
		"group-layers": {
			"kind": "composite",
			"title": "抽象层级",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"completion": {
				"op": "all",
				"items": [
					{
						"op": "ref",
						"id": "same-abstract-plane"
					},
					{
						"op": "ref",
						"id": "no-execution-details"
					},
					{
						"op": "ref",
						"id": "groups-are-abstract"
					}
				]
			}
		},
		"same-abstract-plane": {
			"kind": "leaf",
			"title": "同一深度的节点抽象层级一致",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "逐层查看:同层的每个节点都在回答同一个层级的抽象问题(如第一层都是'目标由哪些本质方面构成')。不能有任何一层级中存在另一层级的节点(把'单件判据'当成'方面'、或把'方面'当成'执行步骤')?"
			}
		},
		"no-execution-details": {
			"kind": "leaf",
			"title": "不存在节点写'怎么做'",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "不存在任何'执行指令'(先做A再做B、写完后渲染、按模板排版这类怎么做)的节点。节点只写目标。"
			}
		},
		"group-leaves": {
			"kind": "composite",
			"title": "叶子语义质量",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"completion": {
				"op": "all",
				"items": [
					{
						"op": "ref",
						"id": "one-judgment"
					},
					{
						"op": "ref",
						"id": "single-purpose"
					},
					{
						"op": "ref",
						"id": "remains-non-formal"
					}
				]
			}
		},
		"one-judgment": {
			"kind": "leaf",
			"title": "一片叶子只一个目标",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "每个叶子节点只包含一个目标(而不是'检查X、Y、Z三个维度后给出结论')。"
			}
		},
		"single-purpose": {
			"kind": "leaf",
			"title": "原子化叶子(无法再拆)",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "每个叶子都不能被拆成两个能各自独立判定的目标。"
			}
		},
		"group-engineering": {
			"kind": "composite",
			"title": "判定工程正确",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"completion": {
				"op": "all",
				"items": [
					{
						"op": "ref",
						"id": "verifier-addressable"
					},
					{
						"op": "ref",
						"id": "human-readable"
					},
					{
						"op": "ref",
						"id": "dependency-direction"
					}
				]
			}
		},
		"verifier-addressable": {
			"kind": "leaf",
			"title": "目标清晰",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "每个叶子的目标边界清晰。"
			}
		},
		"dependency-direction": {
			"kind": "leaf",
			"title": "依赖方向正确",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "每条依赖边中，source 依赖 target(先跑的放 target)，方向没有不小心弄反。"
			}
		},
		"group-complete": {
			"kind": "composite",
			"title": "完备性",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"completion": {
				"op": "all",
				"items": [
					{
						"op": "ref",
						"id": "coverage"
					},
					{
						"op": "ref",
						"id": "no-over-design"
					}
				]
			}
		},
		"coverage": {
			"kind": "leaf",
			"title": "本质面全覆盖",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "站在用户原始目标的角度,图中覆盖了'所有重要方面'。（即容易犯错的方面，不要把不容易犯错的，比如LLM写文本基本不可能会有错别字或者markdown格式错误，此时忽略这种不可能失败的节点）"
			}
		},
		"no-over-design": {
			"kind": "leaf",
			"title": "无与目标无关的枝叶",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "全图不存在'与用户目标无关'的节点."
			}
		},
		"groups-are-abstract": {
			"kind": "leaf",
			"title": "父节点是子节点的抽象",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "对所有节点都满足:它是父节点的在某一方面的实例化，它是子节点的抽象（而不是总结，叠加，子节点具体怎么执行）。"
			}
		},
		"remains-non-formal": {
			"kind": "leaf",
			"title": "叶子仍是非形式化目标",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "每个叶子节点的目标不可能被任何公式/规则/代码测试(如'字数大于X')直接判定。"
			}
		},
		"human-readable": {
			"kind": "leaf",
			"title": "目标说人话",
			"constraint": "hard",
			"target": "generated-dog.graph.json",
			"verifier": {
				"mode": "agentic",
				"goal": "每个叶子的目标中没有出现黑话，即没有背景或上下文无法看懂的名词或者动词。"
			}
		}
	},
