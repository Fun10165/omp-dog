		{ "parent": "reception-decodable", "child": "terms-first", "required": true, "failure": "tolerable" },
		{ "parent": "reception-decodable", "child": "transitions", "required": true, "failure": "tolerable" },
		{ "parent": "reception-decodable", "child": "density-not-too-high", "required": true, "failure": "tolerable" },
