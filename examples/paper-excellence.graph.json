		{ "parent": "warrant-observation", "child": "obs-human-reference", "required": true, "failure": "fatal" },

		{ "parent": "group-fidelity", "child": "no-overstatement", "required": true, "failure": "fatal" },
		{ "parent": "group-fidelity", "child": "no-omission-results", "required": true, "failure": "fatal" },
