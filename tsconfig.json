{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
	"lib": ["ESNext"],
	"types": ["node", "bun"],
	"strict": true,
	"noEmit": true,
	"skipLibCheck": true,
	"allowImportingTsExtensions": true,
	"noUnusedLocals": true,
	"noUnusedParameters": true,
	"noFallthroughCasesInSwitch": true
  },
  "include": ["cli.ts", "omp/**/*.ts", "core/**/*.ts", "studio/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
